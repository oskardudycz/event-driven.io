{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext"
  },
  "include": [
    "site/**/*.ts",
    "scripts/**/*.ts",
    "import/**/*.ts",
    "plugins/**/*.ts",
    "tests/**/*.ts",
    "src/types/**/*.d.ts",
    "src/**/*.unit.test.ts"
  ],
  "exclude": [
    "node_modules",
    "public",
    ".cache",
    "tests/fixtures",
    "tests/**/*.e2e.spec.ts",
    "tests/**/*.browser.test.tsx",
    "tests/helpers/browser",
    "tests/gallery"
  ]
}
