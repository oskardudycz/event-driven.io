---
import { ClientRouter } from 'astro:transitions';
import { renderSitePage } from '../lib/site.ts';
import { refreshDevelopmentRendering } from '../lib/render-content.ts';
import { catalogRevision } from '../lib/catalog.ts';
import type { SitePage as SitePageData } from '../lib/site.ts';
import HeaderIsland from '../components/Header/HeaderIsland.tsx';
import Footer from '../components/Footer/Footer.tsx';
import StaticPage from '../components/StaticPage.tsx';
import HeroIsland from '../components/Hero/HeroIsland.tsx';
import SearchIsland from '../components/Search/SearchIsland.tsx';
import ContactIsland from '../page-views/ContactIsland.tsx';
import NewsletterIsland from '../components/Post/NewsletterIsland.tsx';
import Share from '../components/Post/Share.tsx';
import CommentsIsland from '../components/Post/CommentsIsland.tsx';
import { seoMetadata } from '../lib/seo.ts';
import { fontInitialization } from '../theme/font-initialization.ts';
import { themeInitialization } from '../theme/preference.ts';
import '../theme/tokens.css';
import '../theme/tailwind.css';
import '../theme/global.css';

interface Props {
  page: SitePageData;
}

if (import.meta.env.DEV) refreshDevelopmentRendering(await catalogRevision());
const page = await renderSitePage(Astro.props.page);
const language = page.context.lang;
const tagManager = import.meta.env.PROD && import.meta.env.GOOGLE_TAG_ID;
const tagScript = tagManager
  ? `(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({platform:'astro'});w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer',${JSON.stringify(tagManager)});`
  : '';
const is404 = page.kind === 'notFound';
const head = seoMetadata({
  pageContext: page.context,
  data: page.document,
  useDefaultLangCanonical: page.document.frontmatter.useDefaultLangCanonical,
  ...page.seo,
  facebook: { appId: import.meta.env.FB_APP_ID || '' },
});
---

<!doctype html>
<html lang={language} transition:animate="none">
  <head>
    <ClientRouter fallback="swap" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title id="page-title">{is404 ? `${language === 'pl' ? 'Nie znaleziono strony' : 'Page not found'} - Event-Driven.io` : head.title}</title>
    {is404 && <meta name="robots" content="noindex, nofollow" />}
    {!is404 &&
      head.metaTags.map((tag) => (
        <meta name={tag.name} property={tag.property} content={tag.content} />
      ))}
    {!is404 &&
      head.linkTags.map(({ hrefLang, ...tag }) => (
        <link {...tag} hreflang={hrefLang} />
      ))}
    {!is404 && !head.noIndex && (
      <script
        id="page-schema"
        type="application/ld+json"
        set:html={JSON.stringify(head.structuredData).replace(/</g, '\\u003c')}
      />
    )}
    <script is:inline data-astro-rerun set:html={themeInitialization} />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link
      rel="icon"
      type="image/png"
      sizes="48x48"
      href="/icons/icon-48x48.png"
    />
    <link
      rel="apple-touch-icon"
      sizes="192x192"
      href="/icons/icon-192x192.png"
    />
    <meta name="theme-color" content="#666" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Event-Driven by Oskar Dudycz — articles"
      href="/rss.xml"
    />
    {tagManager && <script is:inline set:html={tagScript} />}

    {(language === 'pl' ? ['latin', 'latin-ext'] : ['latin']).flatMap(
      (subset) =>
        [400, 600].map((weight) => (
          <link
            rel="preload"
            as="font"
            type="font/woff2"
            crossorigin="anonymous"
            href={`/fonts/open-sans/files/open-sans-${subset}-${weight}.woff2`}
          />
        )),
    )}
    <link rel="stylesheet" href="/fonts/open-sans/index.css" id="site-fonts" />
    <script is:inline set:html={fontInitialization} />
  </head>
  <body>
    {tagManager && (
      <noscript>
        <iframe
          title="Google Tag Manager"
          src={`https://www.googletagmanager.com/ns.html?id=${encodeURIComponent(tagManager)}`}
          height="0"
          width="0"
          style="display:none;visibility:hidden"
        />
      </noscript>
    )}
    <script>
      import { trackNavigation } from '../lib/analytics.ts';
      import { loadTwitterWidgets } from '../lib/twitter-client.ts';
      document.addEventListener('astro:page-load', loadTwitterWidgets);
      document.addEventListener('astro:page-load', trackNavigation);
    </script>
    <HeaderIsland
      context={page.context}
      route={page.route}
      pages={page.pages}
      client:load
    />
    <main class="min-h-[80vh]">
      {page.kind === 'search' && (
        <SearchIsland context={page.context} client:load />
      )}
      {page.kind === 'contact' && (
        <ContactIsland context={page.context} client:load />
      )}
      {!['search', 'contact'].includes(page.kind) && (
        <StaticPage page={page}>
          {page.kind === 'home' && page.portrait && (
            <HeroIsland
              slot="hero"
              context={page.context}
              portrait={page.portrait}
              client:load
            />
          )}
          {page.kind === 'post' && (
            <NewsletterIsland
              slot="subscription"
              context={page.context}
              client:load
            />
          )}
          {page.kind === 'post' && (
            <Share
              slot="share"
              post={{
                fields: page.document.fields,
                frontmatter: { title: page.document.frontmatter.title },
              }}
              client:load
            />
          )}
          {page.kind === 'post' && (
            <CommentsIsland
              slot="comments"
              shortname={import.meta.env.GATSBY_DISQUS_NAME || ''}
              config={{
                identifier:
                  page.document.frontmatter.disqusId ||
                  page.document.fields.originalSlug ||
                  page.document.fields.slug,
                title: page.document.frontmatter.title,
              }}
              client:load
            />
          )}
        </StaticPage>
      )}
    </main>
    <Footer html={page.footnote} />
  </body>
</html>
