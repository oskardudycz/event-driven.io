    "gatsby-plugin-remove-serviceworker": "^1.0.0",
    "gatsby-plugin-robots-txt": "^1.8.0",
    "gatsby-plugin-sharp": "^5.16.0",
    "gatsby-plugin-sitemap": "^6.16.0",
    "gatsby-remark-autolink-headers": "^6.16.0",
    "gatsby-remark-copy-linked-files": "^6.16.0",
    "gatsby-remark-embed-video": "3.2.1",
    "gatsby-remark-emojis": "^0.4.3",
    "gatsby-remark-images": "^7.16.0",
    "gatsby-remark-prismjs": "^7.16.0",
    "gatsby-remark-responsive-iframe": "^6.16.0",
    "gatsby-remark-smartypants": "^6.16.0",
    "gatsby-source-filesystem": "^5.16.0",
    "gatsby-transformer-json": "^5.16.0",
    "gatsby-transformer-remark": "^6.16.0",
    "gatsby-transformer-sharp": "^5.16.0",
    "i18next": "^22.0.6",
    "js-yaml": "^4.1.0",
    "lodash": "4.17.21",
    "minisearch": "7.2.0",
    "normalize.css": "^8.0.0",
    "prismjs": "^1.27.0",
    "prop-types": "15.7.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-facebook": "^8.1.4",
    "react-i18next": "^12.0.0",
    "react-icons": "^4.2.0",
    "react-obfuscate": "^3.6.8",
    "react-share": "^5.3.0",
    "react-visibility-sensor": "^5.1.1",
    "shelljs": "^0.8.5",
    "tinycolor2": "^1.4.1",
    "unist-util-visit": "2.0.3",
    "yaml-loader": "^0.6.0"
  },
  "keywords": [
    "gatsby"
  ],
