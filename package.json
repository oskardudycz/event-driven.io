{
  "name": "eternal-sunshine",
  "version": "2.0.0",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11.9 <12"
  },
  "author": "oskar dudycz <oskar.dudycz@gmail.com>",
  "license": "MIT",
  "scripts": {
    "generate-llms": "node ./scripts/generate-llms-txt.ts",
    "verify-seo": "node ./scripts/verify-seo-build.ts",
    "test": "npm run typecheck && npm run test:seo && npm run test:build-contract && npm run test:substack && npm run test:video && npm run test:redirects && npm run test:articles && npm run test:categories && npm run test:performance && npm run test:tooling && npm run test:search && npm run test:localization && npm run test:css && npm run test:404 && npm run test:indexing && npm run test:components && npm run test:indexnow && npm run test:images && npm run test:browser-types",
    "test:seo": "node ./tests/seo-build.test.ts",
    "test:build-contract": "node ./tests/build-contract.test.ts",
    "test:visual": "playwright test",
    "audit:console": "node scripts/audit-console.ts",
    "browsers:install:firefox": "playwright install firefox",
    "audit:performance": "node ./scripts/audit-performance.ts",
    "test:visual:update": "UPDATE_VISUAL_SNAPSHOTS=1 playwright test",
    "test:visual:update:archive": "UPDATE_VISUAL_SNAPSHOTS=1 playwright test archives.spec.ts --grep 'article archive hydrates once'",
    "smoke": "node ./scripts/smoke.ts",
    "verify:build-contract": "node ./scripts/verify-build-contract.ts",
    "update:build-contract": "node ./scripts/update-build-contract.ts",
    "prebuild": "npm run check:images && node ./scripts/generate-llms-txt.ts",
    "import-newsletter": "node ./import/import-newsletter.ts",
    "import-architecture-weekly": "node ./import/import-architecture-weekly.ts",
    "import-and-build": "npm run import-newsletter && npm run import-architecture-weekly && npm run build",
    "build": "gatsby build",
    "clean": "gatsby clean",
    "develop": "gatsby develop",
    "devhost": "gatsby develop --host 192.168.0.112",
    "serve": "gatsby serve",
    "deploy": "netlify deploy --no-build",
    "deploy:prod": "netlify deploy --no-build --prod",
    "format": "npm run fix:prettier",
    "lint-errors": "npm run lint:eslint",
    "lint": "npm run lint:eslint && npm run lint:prettier",
    "generate-app-icons": "node ./scripts/generate-app-icons.ts",
    "import-substack": "node ./import/import-substack.ts",
    "import-articles": "node ./import/import-articles.ts",
    "test:substack": "node ./tests/substack-import.test.ts",
    "test:video": "node ./tests/video-headers.test.ts && node --test --test-isolation=none tests/youtube-markdown.test.ts",
    "test:redirects": "node ./tests/article-redirects.test.ts",
    "test:articles": "node ./tests/article-build.test.ts",
    "test:cache": "node ./scripts/verify-gatsby-cache.ts",
    "lint:modern": "npm run lint:eslint",
    "test:categories": "node ./tests/category-posts.test.ts",
    "browsers:install": "playwright install chromium",
    "browsers:install:ci": "playwright install --with-deps chromium",
    "test:performance": "node --test --test-isolation=none tests/performance.test.ts",
    "lint:eslint": "eslint --cache . --max-warnings 0",
    "lint:prettier": "prettier --cache --check .",
    "fix": "npm run fix:eslint && npm run fix:prettier",
    "fix:eslint": "eslint --cache . --fix --max-warnings 0",
    "fix:prettier": "prettier --cache --write .",
    "lint-staged": "lint-staged",
    "prepare": "husky",
    "test:tooling": "node --test --test-isolation=none tests/tooling.test.ts tests/cli.test.ts",
    "test:search": "node --test --test-isolation=none tests/search.test.ts",
    "measure:search": "node scripts/measure-search.ts",
    "test:search:dev": "node scripts/verify-search-development.ts",
    "test:localization": "node --test --test-isolation=none tests/localization.test.ts",
    "test:css": "node --test --test-isolation=none tests/css-build.test.ts",
    "test:cache:css": "node scripts/verify-gatsby-css-cache.ts",
    "test:404": "node --test --test-isolation=none tests/not-found.test.ts",
    "audit:fonts": "node scripts/profile-fonts.ts",
    "test:indexing": "node --test --test-isolation=none tests/indexing.test.ts",
    "audit:indexing": "node scripts/audit-indexing.ts",
    "normalize:youtube": "node scripts/normalize-youtube.ts",
    "test:components": "vitest run --config tests/vitest.config.ts",
    "postinstall": "patch-package --error-on-fail",
    "indexnow": "node scripts/indexnow.ts",
    "indexnow:prepare": "node scripts/indexnow.ts --prepare",
    "test:indexnow": "node --test --test-isolation=none tests/indexnow.test.ts",
    "check:images": "node scripts/check-image-alternatives.ts",
    "test:images": "npm run check:images && node --test --test-isolation=none tests/image-alternatives.test.ts",
    "test:browser-types": "tsc --project tests/browser/tsconfig.json",
    "typecheck": "tsc --project tsconfig.json && tsc --project tsconfig.node.json",
    "typecheck:watch": "tsc --project tsconfig.json --watch"
  },
  "dependencies": {
    "@weknow/gatsby-remark-twitter": "^0.2.3",
    "disqus-react": "^1.1.7",
    "fontfaceobserver": "2.3.0",
    "gatsby": "5.16.1",
    "gatsby-plugin-catch-links": "^5.16.0",
    "gatsby-plugin-feed": "^5.16.0",
    "gatsby-plugin-google-tagmanager": "^5.16.0",
    "gatsby-plugin-image": "^3.16.0",
    "gatsby-plugin-layout": "^4.16.0",
    "gatsby-plugin-manifest": "^5.16.0",
    "gatsby-plugin-netlify": "^5.1.1",
    "gatsby-plugin-postcss": "^6.16.0",
    "gatsby-plugin-react-i18next": "3.0.1",
    "gatsby-plugin-remove-serviceworker": "^1.0.0",
    "gatsby-plugin-sharp": "^5.16.0",
    "gatsby-plugin-sitemap": "^6.16.0",
    "gatsby-remark-autolink-headers": "^6.16.0",
    "gatsby-remark-copy-linked-files": "^6.16.0",
    "gatsby-remark-embed-video": "3.2.1",
    "gatsby-remark-images": "^7.16.0",
    "gatsby-remark-prismjs": "^7.16.0",
    "gatsby-remark-responsive-iframe": "^6.16.0",
    "gatsby-remark-smartypants": "^6.16.0",
    "gatsby-source-filesystem": "^5.16.0",
    "gatsby-transformer-json": "^5.16.0",
    "gatsby-transformer-remark": "^6.16.0",
    "gatsby-transformer-sharp": "^5.16.0",
    "i18next": "26.4.3",
    "js-yaml": "5.4.3",
    "minisearch": "7.2.0",
    "prismjs": "1.30.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "17.0.16",
    "react-icons": "5.7.0",
    "react-share": "^5.3.0",
    "unist-util-visit": "5.1.0"
  },
  "keywords": [
    "gatsby"
  ],
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/browser-chromium": "1.64.0",
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/escape-html": "^1.0.4",
    "@types/fontfaceobserver": "^2.1.3",
    "@types/mdast": "4.0.4",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/turndown": "^5.0.6",
    "@types/webpack-bundle-analyzer": "^4.7.0",
    "@typescript-eslint/eslint-plugin": "8.71.1",
    "@typescript-eslint/parser": "8.71.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "6.1.2",
    "cheerio": "1.2.0",
    "escape-html": "1.0.3",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "netlify-cli": "27.12.0",
    "netlify-redirect-parser": "14.4.0",
    "patch-package": "8.0.1",
    "pixelmatch": "8.0.0",
    "playwright": "1.64.0",
    "postcss": "8.5.29",
    "postcss-nested": "8.0.1",
    "prettier": "3.9.10",
    "remark": "15.0.1",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "turndown": "7.2.4",
    "turndown-plugin-gfm": "1.0.2",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3",
    "webpack-bundle-analyzer": "5.4.0"
  },
  "overrides": {
    "@types/react": "$@types/react",
    "eslint-plugin-react": {
      "eslint": "$eslint"
    },
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    },
    "gatsby-plugin-react-i18next": {
      "react": "$react",
      "i18next": "$i18next",
      "react-i18next": "$react-i18next"
    }
  },
  "packageManager": "npm@11.9.0"
}
