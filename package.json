{
  "name": "eternal-sunshine",
  "version": "2.0.0",
  "engines": {
    "node": ">=24 <25"
  },
  "author": "oskar dudycz <oskar.dudycz@gmail.com>",
  "license": "MIT",
  "scripts": {
    "generate-llms": "node ./scripts/generate-llms-txt.js",
    "verify-seo": "node ./scripts/verify-seo-build.js",
    "test": "yarn test:seo && yarn test:build-contract && yarn test:substack && yarn test:video && yarn test:redirects && yarn test:articles && yarn test:categories && yarn test:performance && yarn test:tooling && yarn test:search && yarn test:localization && yarn test:css && yarn test:404 && yarn test:indexing && yarn test:components && yarn test:indexnow && yarn test:images && yarn test:browser-types",
    "test:seo": "node ./tests/seo-build.test.js",
    "test:build-contract": "node ./tests/build-contract.test.js",
    "test:visual": "playwright test",
    "audit:console": "node scripts/audit-console.mts",
    "browsers:install:firefox": "playwright install firefox",
    "audit:performance": "node ./scripts/audit-performance.mjs",
    "test:visual:update": "UPDATE_VISUAL_SNAPSHOTS=1 playwright test",
    "test:visual:update:archive": "UPDATE_VISUAL_SNAPSHOTS=1 playwright test archives.spec.ts --grep 'article archive hydrates once'",
    "smoke": "node ./scripts/smoke-migration.js",
    "verify:build-contract": "node ./scripts/verify-build-contract.js",
    "update:build-contract": "node ./scripts/update-build-contract.js",
    "prebuild": "yarn check:images && yarn generate-theme-css && node ./scripts/generate-llms-txt.js",
    "import-newsletter": "node ./import/import-newsletter.js",
    "import-architecture-weekly": "node ./import/import-architecture-weekly.js",
    "import-and-build": "yarn import-newsletter && yarn import-architecture-weekly && yarn build",
    "build": "gatsby build",
    "clean": "gatsby clean",
    "develop": "gatsby develop",
    "devhost": "gatsby develop --host 192.168.0.112",
    "serve": "gatsby serve",
    "deploy": "netlify deploy",
    "deploy:prod": "netlify deploy --prod",
    "format": "yarn fix:prettier",
    "lint-errors": "yarn lint:eslint",
    "lint": "yarn lint:eslint && yarn lint:prettier",
    "stylelint": "stylelint src/**/*.js",
    "generate-app-icons": "sh ./scripts/generate-app-icons.sh",
    "import-substack": "node ./import/import-substack.js",
    "import-articles": "node ./import/import-articles.js",
    "test:substack": "node ./tests/substack-import.test.js",
    "test:video": "node ./tests/video-headers.test.js && node --test --test-isolation=none tests/youtube-markdown.test.mts",
    "test:redirects": "node ./tests/article-redirects.test.js",
    "test:articles": "node ./tests/article-build.test.js",
    "test:cache": "node ./scripts/verify-gatsby-cache.mjs",
    "lint:modern": "yarn lint:eslint",
    "test:categories": "node ./tests/category-posts.test.mjs",
    "browsers:install": "playwright install chromium",
    "browsers:install:ci": "playwright install --with-deps chromium",
    "test:performance": "node --test --test-isolation=none tests/performance.test.mjs",
    "lint:eslint": "eslint --cache . --max-warnings 0",
    "lint:prettier": "prettier --cache --check .",
    "fix": "yarn fix:eslint && yarn fix:prettier",
    "fix:eslint": "eslint --cache . --fix --max-warnings 0",
    "fix:prettier": "prettier --cache --write .",
    "lint-staged": "lint-staged",
    "prepare": "husky",
    "test:tooling": "node --test --test-isolation=none tests/tooling.test.mjs",
    "test:search": "node --test --test-isolation=none tests/search.test.mjs",
    "measure:search": "node scripts/measure-search.mjs",
    "test:search:dev": "node scripts/verify-search-development.mjs",
    "test:localization": "node --test --test-isolation=none tests/localization.test.mjs",
    "generate-theme-css": "node scripts/generate-theme-css.mts",
    "predevelop": "yarn generate-theme-css",
    "predevhost": "yarn generate-theme-css",
    "test:css": "node --test --test-isolation=none tests/css-build.test.mts",
    "test:cache:css": "node scripts/verify-gatsby-css-cache.mts",
    "test:404": "node --test --test-isolation=none tests/not-found.test.mts",
    "audit:fonts": "node scripts/profile-fonts.mts",
    "test:indexing": "node --test --test-isolation=none tests/indexing.test.mts",
    "audit:indexing": "node scripts/audit-indexing.mts",
    "normalize:youtube": "node scripts/normalize-youtube.mts",
    "test:components": "vitest run tests/link.test.tsx tests/reading-list.test.tsx",
    "postinstall": "patch-package --error-on-fail",
    "indexnow": "node scripts/indexnow.mts",
    "indexnow:prepare": "node scripts/indexnow.mts --prepare",
    "test:indexnow": "node --test --test-isolation=none tests/indexnow.test.mts",
    "check:images": "node scripts/check-image-alternatives.mts",
    "test:images": "yarn check:images && node --test --test-isolation=none tests/image-alternatives.test.mts",
    "test:browser-types": "tsc --project tests/browser/tsconfig.json"
  },
  "dependencies": {
    "@ant-design/compatible": "^1.0.8",
    "@babel/core": "^7.29.7",
