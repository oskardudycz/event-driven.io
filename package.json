{
  "name": "eternal-sunshine",
  "version": "2.0.0",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11.9 <12"
  },
  "author": "oskar dudycz <oskar.dudycz@gmail.com>",
  "license": "MIT",
  "scripts": {
    "audit:console": "node scripts/audit-console.ts",
    "audit:fonts": "node scripts/profile-fonts.ts",
    "audit:indexing": "node scripts/audit-indexing.ts",
    "audit:performance": "node ./scripts/audit-performance.ts",
    "browsers:install": "playwright install chromium",
    "browsers:install:ci": "playwright install --with-deps chromium",
    "browsers:install:firefox": "playwright install firefox",
    "build": "gatsby build",
    "check:content": "npm run check:images",
    "check:edit": "npm run check:content && npm run test:unit && npm run test:int",
    "check:images": "node scripts/check-image-alternatives.ts",
    "clean": "gatsby clean",
    "deploy": "netlify deploy --no-build",
    "deploy:prod": "netlify deploy --no-build --prod",
    "dev": "gatsby develop",
    "dev:components": "vite --config tests/gallery/vite.config.ts",
    "fix": "npm run fix:eslint && npm run fix:prettier",
    "fix:eslint": "eslint --cache . --fix --max-warnings 0",
    "fix:prettier": "prettier --cache --write .",
    "generate-app-icons": "node ./scripts/generate-app-icons.ts",
    "generate-llms": "node ./scripts/generate-llms-txt.ts",
    "import-and-build": "npm run import-newsletter && npm run import-architecture-weekly && npm run build",
    "import-architecture-weekly": "node ./import/import-architecture-weekly.ts",
    "import-articles": "node ./import/import-articles.ts",
    "import-newsletter": "node ./import/import-newsletter.ts",
    "import-substack": "node ./import/import-substack.ts",
    "indexnow": "node scripts/indexnow.ts",
    "indexnow:prepare": "node scripts/indexnow.ts --prepare",
    "lint": "npm run lint:eslint && npm run lint:prettier",
    "lint-staged": "lint-staged",
    "lint:eslint": "eslint --cache . --max-warnings 0",
    "lint:prettier": "prettier --cache --check .",
    "measure:search": "node scripts/measure-search.ts",
    "normalize:youtube": "node scripts/normalize-youtube.ts",
    "postinstall": "patch-package --error-on-fail",
    "prebuild": "npm run check:images && node ./scripts/generate-llms-txt.ts",
    "prepare": "husky",
    "render-diagrams": "node ./scripts/render-mermaid.ts",
    "serve": "gatsby serve",
    "smoke": "node ./scripts/smoke.ts",
    "test": "npm run test:unit && npm run test:int && npm run test:generated && npm run test:e2e",
    "test:browser": "vitest run --config tests/vitest.config.ts --project browser",
    "test:e2e": "playwright test --config tests/playwright.config.ts",
    "test:e2e:dev": "GATSBY_TEST_MODE=development playwright test --config tests/playwright.config.ts",
    "test:e2e:report": "playwright show-report visual-artifacts/report",
    "test:e2e:update": "UPDATE_VISUAL_SNAPSHOTS=1 playwright test --config tests/playwright.config.ts",
    "test:file": "vitest run --config tests/vitest.config.ts",
    "test:generated": "vitest run --config tests/vitest.config.ts --project generated",
    "test:int": "vitest run --config tests/vitest.config.ts --project integration --project browser",
    "test:unit": "vitest run --config tests/vitest.config.ts --project unit",
    "test:watch": "vitest --config tests/vitest.config.ts --project unit --project integration --project browser",
    "typecheck": "tsc --project tsconfig.json && tsc --project tsconfig.node.json",
    "typecheck:watch": "tsc --project tsconfig.json --watch",
    "update:build-contract": "node ./scripts/update-build-contract.ts",
    "verify-seo": "node ./scripts/verify-seo-build.ts",
    "verify:build-contract": "node ./scripts/verify-build-contract.ts",
    "verify:cache": "node scripts/verify-gatsby-cache.ts",
    "verify:cache:css": "node scripts/verify-gatsby-css-cache.ts",
    "verify:publication": "npm run smoke && npm run lint && npm run typecheck && npm run check:edit && npm run build && npm run test:generated && npm run test:e2e",
    "verify:search:dev": "node scripts/verify-search-development.ts"
  },
  "dependencies": {
    "@weknow/gatsby-remark-twitter": "^0.2.3",
    "disqus-react": "^1.1.7",
    "gatsby": "5.16.1",
    "gatsby-plugin-catch-links": "^5.16.0",
    "gatsby-plugin-feed": "^5.16.0",
    "gatsby-plugin-google-tagmanager": "^5.16.0",
    "gatsby-plugin-image": "^3.16.0",
    "gatsby-plugin-layout": "^4.16.0",
    "gatsby-plugin-manifest": "^5.16.0",
    "gatsby-plugin-netlify": "^5.1.1",
    "gatsby-plugin-postcss": "^6.16.0",
    "gatsby-plugin-react-i18next": "3.0.1",
    "gatsby-plugin-remove-serviceworker": "^1.0.0",
    "gatsby-plugin-sharp": "5.16.0",
    "gatsby-plugin-sitemap": "^6.16.0",
    "gatsby-remark-autolink-headers": "^6.16.0",
    "gatsby-remark-copy-linked-files": "^6.16.0",
    "gatsby-remark-embed-video": "3.2.1",
    "gatsby-remark-images": "^7.16.0",
    "gatsby-remark-prismjs": "^7.16.0",
    "gatsby-remark-responsive-iframe": "^6.16.0",
    "gatsby-remark-smartypants": "^6.16.0",
    "gatsby-source-filesystem": "^5.16.0",
    "gatsby-transformer-remark": "^6.16.0",
    "gatsby-transformer-sharp": "^5.16.0",
    "i18next": "26.4.4",
    "js-yaml": "5.4.3",
    "minisearch": "7.2.0",
    "prismjs": "1.30.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "17.0.16",
    "react-icons": "5.7.0",
    "react-share": "6.1.0",
    "unist-util-visit": "5.1.0"
  },
  "keywords": [
    "gatsby"
  ],
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/browser-chromium": "1.64.0",
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/escape-html": "^1.0.4",
    "@types/mdast": "4.0.4",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/turndown": "^5.0.6",
    "@types/webpack-bundle-analyzer": "^4.7.0",
    "@typescript-eslint/eslint-plugin": "8.71.2",
    "@typescript-eslint/parser": "8.71.2",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/browser-playwright": "5.0.4",
    "cheerio": "1.2.0",
    "escape-html": "1.0.3",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "netlify-cli": "27.12.0",
    "netlify-redirect-parser": "14.4.0",
    "patch-package": "8.0.1",
    "pixelmatch": "8.0.0",
    "playwright": "1.64.0",
    "postcss": "8.5.30",
    "postcss-nested": "8.0.1",
    "prettier": "3.9.10",
    "remark": "15.0.1",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "turndown": "7.2.4",
    "turndown-plugin-gfm": "1.0.2",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4",
    "vitest-browser-react": "2.3.0",
    "webpack-bundle-analyzer": "5.4.0"
  },
  "overrides": {
    "@types/react": "$@types/react",
    "@ardatan/relay-compiler": {
      "immutable": "3.8.4"
    },
    "@graphql-codegen/plugin-helpers": {
      "lodash": "4.18.1"
    },
    "eslint-plugin-react": {
      "eslint": "$eslint"
    },
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    },
    "gatsby-plugin-react-i18next": {
      "react": "$react",
      "i18next": "$i18next",
      "react-i18next": "$react-i18next"
    }
  },
  "packageManager": "npm@11.9.0"
}
