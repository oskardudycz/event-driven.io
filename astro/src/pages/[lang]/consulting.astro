---
import { getCollection } from 'astro:content';
import Article from '../../../../src/components/Article/Article.tsx';
import Page from '../../../../src/components/Page/Page.tsx';
import Appearance from '../../components/Appearance.tsx';
import { seoMetadata } from '../../../../src/components/Seo/Seo.tsx';
import { themeInitialization } from '../../../../src/theme/preference.ts';
import '../../../../src/theme/tokens.css';
import '../../../../src/theme/tailwind.css';
import '../../../../src/theme/global.css';

export async function getStaticPaths() {
  return (await getCollection('pages')).map((entry) => ({
    params: { lang: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
if (!entry.rendered) throw new Error(`Missing rendered Markdown: ${entry.id}`);
const language = entry.id;
const page = {
  fields: { slug: '/consulting/', langKey: language, source: 'pages' },
  frontmatter: entry.data,
  html: entry.rendered.html,
};
const head = seoMetadata({
  pageContext: { lang: language, originalPath: '/consulting/', supportedLanguages: ['en', 'pl'] },
  data: page,
  facebook: { appId: import.meta.env.FB_APP_ID || '' },
});
---
<!doctype html>
<html lang={language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{head.title}</title>
    {head.metaTags.map((tag) => <meta {...tag} />)}
    {head.linkTags.map(({ hrefLang, ...tag }) => <link {...tag} hreflang={hrefLang} />)}
    <script type="application/ld+json" set:html={JSON.stringify(head.structuredData).replace(/</g, '\\u003c')} />
    <script is:inline set:html={themeInitialization} />
    <link rel="stylesheet" href="/fonts/open-sans/index.css" />
  </head>
  <body>

    <main><Article><Page page={page} /></Article></main>
    <nav style="display: flex; align-items: center; justify-content: space-between; padding: var(--space-md)" aria-label={language === 'pl' ? 'Język' : 'Language'}>
      <a href={`/${language === 'en' ? 'pl' : 'en'}/consulting/`} hreflang={language === 'en' ? 'pl' : 'en'}>{language === 'en' ? 'Polski' : 'English'}</a>
      <Appearance language={language} client:load />
    </nav>
  </body>
</html>
