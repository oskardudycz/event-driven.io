{
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "types": ["node", "react", "react-dom"]
  },
  "include": [
    "astro/**/*.ts",
    "astro/src/**/*.tsx",
    "src/**/*.ts",
    "src/**/*.tsx",
    "content/meta/config.ts",
    "scripts/**/*.ts",
    "import/**/*.ts",
    "tests/**/*.ts",
    "tests/**/*.tsx"
  ],
  "exclude": ["node_modules", "public", ".cache", "tests/fixtures"],
  "extends": "./tsconfig.shared.json"
}
